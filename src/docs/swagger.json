{
  "openapi": "3.0.0",
  "info": {
    "title": "Bharat Local: Multilingual Location-Based Community API",
    "version": "1.0.0",
    "description": "Comprehensive backend REST API for hyperlocal multilingual community engagement across India. Includes phone OTP auth, PostgreSQL indexing, Redis feed caching, async notifications queue, and moderation workflows."
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Local Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string", "example": "VALIDATION_ERROR" },
              "message": { "type": "string", "example": "Invalid input provided" },
              "details": { "type": "array", "items": { "type": "object" } }
            }
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "phone": { "type": "string", "example": "+919876543210" },
          "name": { "type": "string", "example": "Anand Kumar" },
          "role": { "type": "string", "enum": ["user", "moderator", "admin"] },
          "preferred_language": { "type": "string", "example": "hi" },
          "state": { "type": "string", "example": "Karnataka" },
          "city": { "type": "string", "example": "Bengaluru" },
          "locality": { "type": "string", "example": "Indiranagar" },
          "pincode": { "type": "string", "example": "560038" }
        }
      },
      "Post": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "author_id": { "type": "string", "format": "uuid" },
          "author_name": { "type": "string", "example": "Anand Kumar" },
          "category_id": { "type": "string", "example": "services" },
          "category_name": { "type": "string", "example": "Local Services & Utilities" },
          "title": { "type": "string", "example": "Affordable Spoken English Coaching" },
          "content": { "type": "string", "example": "Weekend classes starting this Saturday..." },
          "language": { "type": "string", "example": "en" },
          "state": { "type": "string", "example": "Karnataka" },
          "city": { "type": "string", "example": "Bengaluru" },
          "locality": { "type": "string", "example": "Indiranagar" },
          "pincode": { "type": "string", "example": "560038" },
          "contact_info": { "type": "string", "example": "+919876543210" },
          "status": { "type": "string", "enum": ["active", "pending_review", "flagged", "hidden", "rejected"] },
          "report_count": { "type": "integer", "example": 0 },
          "view_count": { "type": "integer", "example": 25 },
          "created_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "System Health & Engine Metrics",
        "description": "Returns status of PostgreSQL, Redis cache, and notification background worker queue.",
        "responses": {
          "200": { "description": "System is healthy" }
        }
      }
    },
    "/api/v1/auth/request-otp": {
      "post": {
        "summary": "Request Phone OTP for Login/Signup",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["phone"],
                "properties": {
                  "phone": { "type": "string", "example": "+919876543210" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "OTP generated and dispatched" }
        }
      }
    },
    "/api/v1/auth/verify-otp": {
      "post": {
        "summary": "Verify OTP and obtain JWT Bearer Token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["phone", "otp"],
                "properties": {
                  "phone": { "type": "string", "example": "+919876543210" },
                  "otp": { "type": "string", "example": "123456" },
                  "name": { "type": "string", "example": "Anand Kumar" },
                  "preferred_language": { "type": "string", "example": "kn" },
                  "city": { "type": "string", "example": "Bengaluru" },
                  "pincode": { "type": "string", "example": "560038" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Authentication successful, returns JWT token" }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "summary": "Get authenticated user profile",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "User profile" },
          "401": { "description": "Unauthorized" }
        }
      },
      "put": {
        "summary": "Update user preferences (language, location)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Preferences updated" }
        }
      }
    },
    "/api/v1/auth/demo-personas": {
      "get": {
        "summary": "Pre-configured test personas with JWT tokens (Admin, Moderator, Citizens)",
        "responses": {
          "200": { "description": "List of demo personas" }
        }
      }
    },
    "/api/v1/feed": {
      "get": {
        "summary": "Hyperlocal Community Feed with Redis Caching",
        "parameters": [
          { "name": "city", "in": "query", "schema": { "type": "string", "example": "Jaipur" } },
          { "name": "locality", "in": "query", "schema": { "type": "string", "example": "C-Scheme" } },
          { "name": "category", "in": "query", "schema": { "type": "string", "example": "announcements" } },
          { "name": "language", "in": "query", "schema": { "type": "string", "example": "hi" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 10 } },
          { "name": "sort", "in": "query", "schema": { "type": "string", "enum": ["latest", "oldest", "popular"], "default": "latest" } }
        ],
        "responses": {
          "200": { "description": "Paginated community feed" }
        }
      }
    },
    "/api/v1/posts": {
      "post": {
        "summary": "Create a new local community post",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "201": { "description": "Post created" }
        }
      }
    },
    "/api/v1/posts/{id}": {
      "get": {
        "summary": "Get post details and increment view count",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Post details" },
          "404": { "description": "Post not found" }
        }
      },
      "put": {
        "summary": "Edit existing post (Author or Moderator/Admin)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Post updated" }
        }
      },
      "delete": {
        "summary": "Delete post (Author or Moderator/Admin)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Post deleted" }
        }
      }
    },
    "/api/v1/posts/{id}/report": {
      "post": {
        "summary": "Report inappropriate post (Triggers async moderator alert queue)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["reason"],
                "properties": {
                  "reason": { "type": "string", "enum": ["spam", "hate_speech", "misinformation", "inappropriate", "fraud", "other"] },
                  "details": { "type": "string", "example": "Spam promotional link" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Report submitted and enqueued" }
        }
      }
    },
    "/api/v1/search": {
      "get": {
        "summary": "Multilingual full-text search with filters",
        "parameters": [
          { "name": "q", "in": "query", "required": true, "schema": { "type": "string", "example": "water" } },
          { "name": "city", "in": "query", "schema": { "type": "string" } },
          { "name": "category", "in": "query", "schema": { "type": "string" } },
          { "name": "language", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Search results" }
        }
      }
    },
    "/api/v1/moderation/reports": {
      "get": {
        "summary": "View reported posts moderation queue (Moderators & Admins)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "List of reported items" }
        }
      }
    },
    "/api/v1/moderation/posts/{id}/action": {
      "post": {
        "summary": "Approve, Reject, or Hide reported post (Triggers async notifications)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["action"],
                "properties": {
                  "action": { "type": "string", "enum": ["approved", "rejected", "hidden", "restored"] },
                  "notes": { "type": "string", "example": "Complies with community standards" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Moderation action recorded and notification enqueued" }
        }
      }
    },
    "/api/v1/moderation/broadcast": {
      "post": {
        "summary": "Broadcast emergency or public announcement across district (Admin only)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Broadcast enqueued" }
        }
      }
    },
    "/api/v1/moderation/stats": {
      "get": {
        "summary": "Community health, cache efficiency, and queue metrics",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Metrics summary" }
        }
      }
    },
    "/api/v1/notifications": {
      "get": {
        "summary": "Retrieve user notification inbox",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Notifications list" }
        }
      }
    }
  }
}
