# Bharat Local API - Environment Configuration

# Server
PORT=5000
NODE_ENV=development
APP_NAME=BharatLocal

# JWT Authentication
JWT_SECRET=bharat_local_super_secret_jwt_key_2026_dev
JWT_EXPIRES_IN=7d

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bharat_local
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=bharat_local
PGSSL=false

# In-Memory DB fallback mode if Postgres service is not yet running
ENABLE_MEMORY_DB_FALLBACK=true

# Redis Cache & Notification Queue
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CACHE_TTL_SECONDS=300
ENABLE_MEMORY_CACHE_FALLBACK=true

# Notification / Queue Settings
NOTIFICATION_WORKER_CONCURRENCY=5
OTP_DEV_MOCK_CODE=123456
OTP_EXPIRY_MINUTES=5

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
